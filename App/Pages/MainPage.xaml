<Page 
    x:Class="App.MainPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    
    <Page.Resources>
        <Style x:Key="RecognitionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="144"/>
            <Setter Property="Height" Value="144"/>
            <Setter Property="Background" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.65" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Disc" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            
                            <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}"/>
                            
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar x:Name="CommandBar">
            <AppBarButton x:Uid="HistoryButton" x:Name="HistoryButton" Icon="Clock" Click="OpenHistory_Click"/>
            
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="OfflineRecognitionsButton" x:Name="OfflineRecognitionsButton" Click="OfflineRecognitions_Click"/>
                <AppBarSeparator/>
                <AppBarButton x:Uid="SettingsButton" x:Name="SettingsButton" Click="Settings_Click" />
                <AppBarButton x:Uid="MicrophoneSettingsButton" x:Name="MicrophoneSettingsButton" Click="MicrophoneSettings_Click" />
                <AppBarSeparator/>
                <AppBarButton x:Uid="AboutButton" Click="About_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    
    <Grid x:Name="LayoutRoot" SizeChanged="Layout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid x:Name="HomeView" Margin="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock x:Name="RecognitionPrompt" FontSize="26" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

                    <Viewbox x:Name="RecognitionButtonBox" Width="176" Height="176" HorizontalAlignment="Center">
                        <Grid Width="176" Height="176">
                            <Ellipse x:Name="WindowProgressTrack" Visibility="Collapsed" Width="168" Height="168" Stroke="{ThemeResource SystemControlForegroundBaseLowBrush}" StrokeThickness="4"/>
                            <Path x:Name="WindowProgressArc" Visibility="Collapsed" Stroke="{ThemeResource SystemControlHighlightAccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                            <Button x:Name="ListenButton" Style="{StaticResource RecognitionButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Listen_Click">
                                <Viewbox Width="48" Height="48">
                                    <SymbolIcon Symbol="Microphone"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Viewbox>

                    <TextBlock x:Name="RecognitionHint" TextAlignment="Center" TextWrapping="Wrap" Opacity="0.65" Margin="0,24,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar, useful for debugging and error handling-->
        <TextBlock x:Name="Status" Grid.Row="2" Visibility="Collapsed" TextWrapping="Wrap" Margin="20,4,20,8"/>

        <!-- This is the card that appears after successful recogintion -->
        <Border x:Name="ResultNotice" Tapped="Notice_Tapped" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" MaxWidth="560" Margin="12" Padding="16" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" BorderThickness="0,4,0,0" CornerRadius="4">
            <Border.RenderTransform>
                <TranslateTransform x:Name="NoticeTranslation"/>
            </Border.RenderTransform>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="NoticeTitle" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="20" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NoticeArtist" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="16" TextWrapping="Wrap"/>
                </StackPanel>
                
                <Button x:Name="DismissNoticeButton" Grid.Column="1" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="DismissNotice_Click" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
