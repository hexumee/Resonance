<Page
    x:Class="App.MicrophoneSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Stretch" Margin="16 8 16 8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="MicrophoneSettingsPageHeading" Grid.Row="0" FontSize="16" Margin="0 0 0 16" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">
                <ComboBox x:Uid="MicrophoneDevicePicker" x:Name="Microphones" DisplayMemberPath="Name" SelectionChanged="Microphone_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                <ComboBox x:Uid="CaptureModePicker" x:Name="CaptureMode" SelectedIndex="0" SelectionChanged="CaptureMode_Changed" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                    <ComboBoxItem x:Uid="StandardCaptureMode"/>
                    <ComboBoxItem x:Uid="RawCaptureMode"/>
                </ComboBox>

                <Button x:Uid="MicrophoneTestButton" x:Name="TestButton" Click="Test_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button x:Uid="RefreshMicrophonesButton" x:Name="RefreshButton" Click="Refresh_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button x:Uid="PlayMicrophoneTestButton" x:Name="PlayTestButton" Click="PlayTest_Click" IsEnabled="False" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                <Button x:Uid="PlayDiagnosticToneButton" x:Name="ToneButton" Click="Tone_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                <TextBlock x:Name="PlaybackStatus" TextWrapping="Wrap" Margin="0,8"/>
                <StackPanel x:Name="LevelPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <ProgressBar x:Name="LevelBar" Minimum="0" Maximum="100" Height="6"/>
                    <TextBlock x:Name="LevelText" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8"/>

                <TextBlock x:Name="Signal" TextWrapping="Wrap" Margin="0,8"/>

                <Button x:Uid="CancelMicrophoneCheckButton" x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed" IsEnabled="False"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
